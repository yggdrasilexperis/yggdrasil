# --- Database (docker compose reads this file) ---
POSTGRES_DB=yggdrasil
POSTGRES_USER=yggdrasil
POSTGRES_PASSWORD=enter-password-here
# change the port if something else already listens on 5432.
POSTGRES_PORT=5432

# --- API (backend/Yggdrasil.Api) ---
# The API does NOT read this file. Locally, store each value with user secrets,
# writing ':' instead of '__' (README steps 4, 5 and 7):
#   dotnet user-secrets set "Jwt:IssuerSigningKey" "<value>" --project backend/Yggdrasil.Api
# In the cloud, set them as environment variables exactly as written below.
#
# Must match the POSTGRES_* values above.
# ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=yggdrasil;Username=yggdrasil;Password=enter-password-here
#
# At least 32 bytes. Generate with: openssl rand -hex 48
# Jwt__IssuerSigningKey=replace-me
#
# Only needed to run --seed.
# Seed__Password=enter-seed-password-here
#
# Only needed outside Development; appsettings.Development.json sets it locally.
# Add __1, __2 and so on for more origins.
# Cors__AllowedOrigins__0=https://your-frontend.example.com